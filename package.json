{
	"name": "obsidian-snippets-manager",
	"version": "1.0.0",
	"description": "Port of MySnippets for modern Obsidian snippet management.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"css",
		"snippets"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"esbuild": "latest",
		"eslint": "latest",
		"obsidian": "latest",
		"tslib": "latest",
		"typescript": "latest"
	}
}
